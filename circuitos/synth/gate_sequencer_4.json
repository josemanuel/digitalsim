{
  "formatVersion": "1.0",
  "circuit": {
    "id": "gate_sequencer_4",
    "components": [
      { "id": "clk", "type": "CLOCK", "label": "TEMPO", "params": { "period": 30, "width": 1, "initialValue": 0 }, "position": { "x": 40, "y": 120 }, "rotation": 0 },
      { "id": "run", "type": "SWITCH", "label": "RUN", "params": { "width": 1, "initialValue": 1 }, "position": { "x": 40, "y": 230 }, "rotation": 0 },
      { "id": "rst", "type": "PUSH_BUTTON", "label": "RST", "params": { "activeHigh": true, "width": 1, "initialValue": 0 }, "position": { "x": 40, "y": 320 }, "rotation": 0 },
      { "id": "cnt", "type": "COUNTER", "label": "STEP", "params": { "bitWidth": 2, "mode": "up", "hasEnable": true, "hasClear": true, "hasLoad": false }, "position": { "x": 240, "y": 140 }, "rotation": 0 },
      { "id": "dec", "type": "DECODER", "label": "STEPS", "params": { "selWidth": 2, "hasEnable": false }, "position": { "x": 440, "y": 140 }, "rotation": 0 },
      { "id": "s1", "type": "LED", "label": "STEP1", "params": { "width": 1 }, "position": { "x": 660, "y": 20 }, "rotation": 0 },
      { "id": "s2", "type": "LED", "label": "STEP2", "params": { "width": 1 }, "position": { "x": 660, "y": 110 }, "rotation": 0 },
      { "id": "s3", "type": "LED", "label": "STEP3", "params": { "width": 1 }, "position": { "x": 660, "y": 200 }, "rotation": 0 },
      { "id": "s4", "type": "LED", "label": "STEP4", "params": { "width": 1 }, "position": { "x": 660, "y": 290 }, "rotation": 0 }
    ],
    "nets": [
      { "id": "n1", "width": 1, "pins": [{ "component": "clk", "pin": "out" }, { "component": "cnt", "pin": "clk" }] },
      { "id": "n2", "width": 1, "pins": [{ "component": "run", "pin": "out" }, { "component": "cnt", "pin": "en" }] },
      { "id": "n3", "width": 1, "pins": [{ "component": "rst", "pin": "out" }, { "component": "cnt", "pin": "clr" }] },
      { "id": "n4", "width": 2, "pins": [{ "component": "cnt", "pin": "q" }, { "component": "dec", "pin": "sel" }] },
      { "id": "n5", "width": 1, "pins": [{ "component": "dec", "pin": "out0" }, { "component": "s1", "pin": "in" }] },
      { "id": "n6", "width": 1, "pins": [{ "component": "dec", "pin": "out1" }, { "component": "s2", "pin": "in" }] },
      { "id": "n7", "width": 1, "pins": [{ "component": "dec", "pin": "out2" }, { "component": "s3", "pin": "in" }] },
      { "id": "n8", "width": 1, "pins": [{ "component": "dec", "pin": "out3" }, { "component": "s4", "pin": "in" }] }
    ]
  }
}
