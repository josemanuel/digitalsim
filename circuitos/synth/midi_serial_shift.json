{
  "formatVersion": "1.0",
  "circuit": {
    "id": "midi_serial_shift",
    "components": [
      { "id": "bit", "type": "SWITCH", "label": "SERIAL IN", "params": { "width": 1, "initialValue": 0 }, "position": { "x": 40, "y": 80 }, "rotation": 0 },
      { "id": "clk", "type": "PUSH_BUTTON", "label": "BIT CLK", "params": { "activeHigh": true, "width": 1, "initialValue": 0 }, "position": { "x": 40, "y": 200 }, "rotation": 0 },
      { "id": "shift", "type": "SHIFT_REGISTER", "label": "MIDI BYTE", "params": { "bitWidth": 8, "direction": "right", "hasParallelLoad": false }, "position": { "x": 280, "y": 120 }, "rotation": 0 },
      { "id": "hex", "type": "HEX_MONITOR", "label": "BYTE", "params": { "width": 8, "format": "hex" }, "position": { "x": 520, "y": 60 }, "rotation": 0 },
      { "id": "bin", "type": "BINARY_MONITOR", "label": "BYTE bin", "params": { "width": 8, "format": "binary" }, "position": { "x": 520, "y": 180 }, "rotation": 0 },
      { "id": "ser_led", "type": "LED", "label": "serOut", "params": { "width": 1 }, "position": { "x": 520, "y": 300 }, "rotation": 0 }
    ],
    "nets": [
      { "id": "n1", "width": 1, "pins": [{ "component": "bit", "pin": "out" }, { "component": "shift", "pin": "serIn" }] },
      { "id": "n2", "width": 1, "pins": [{ "component": "clk", "pin": "out" }, { "component": "shift", "pin": "clk" }] },
      { "id": "n3", "width": 8, "pins": [{ "component": "shift", "pin": "q" }, { "component": "hex", "pin": "in" }, { "component": "bin", "pin": "in" }] },
      { "id": "n4", "width": 1, "pins": [{ "component": "shift", "pin": "serOut" }, { "component": "ser_led", "pin": "in" }] }
    ]
  }
}
