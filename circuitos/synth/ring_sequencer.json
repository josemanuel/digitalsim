{
  "formatVersion": "1.0",
  "circuit": {
    "id": "ring_sequencer",
    "components": [
      { "id": "clk", "type": "CLOCK", "label": "TEMPO", "params": { "period": 22, "width": 1, "initialValue": 0 }, "position": { "x": 40, "y": 160 }, "rotation": 0 },
      { "id": "cnt", "type": "COUNTER", "label": "RING", "params": { "bitWidth": 8, "mode": "ring", "hasEnable": false, "hasClear": true, "hasLoad": false }, "position": { "x": 240, "y": 160 }, "rotation": 0 },
      { "id": "rst", "type": "PUSH_BUTTON", "label": "RST", "params": { "activeHigh": true, "width": 1, "initialValue": 0 }, "position": { "x": 40, "y": 280 }, "rotation": 0 },
      { "id": "split", "type": "SPLITTER", "label": "STEPS", "params": { "width": 8, "splits": [1, 1, 1, 1, 1, 1, 1, 1] }, "position": { "x": 460, "y": 160 }, "rotation": 0 },
      { "id": "s0", "type": "LED", "label": "1", "params": { "width": 1 }, "position": { "x": 680, "y": 0 }, "rotation": 0 },
      { "id": "s1", "type": "LED", "label": "2", "params": { "width": 1 }, "position": { "x": 680, "y": 55 }, "rotation": 0 },
      { "id": "s2", "type": "LED", "label": "3", "params": { "width": 1 }, "position": { "x": 680, "y": 110 }, "rotation": 0 },
      { "id": "s3", "type": "LED", "label": "4", "params": { "width": 1 }, "position": { "x": 680, "y": 165 }, "rotation": 0 },
      { "id": "s4", "type": "LED", "label": "5", "params": { "width": 1 }, "position": { "x": 680, "y": 220 }, "rotation": 0 },
      { "id": "s5", "type": "LED", "label": "6", "params": { "width": 1 }, "position": { "x": 680, "y": 275 }, "rotation": 0 },
      { "id": "s6", "type": "LED", "label": "7", "params": { "width": 1 }, "position": { "x": 680, "y": 330 }, "rotation": 0 },
      { "id": "s7", "type": "LED", "label": "8", "params": { "width": 1 }, "position": { "x": 680, "y": 385 }, "rotation": 0 }
    ],
    "nets": [
      { "id": "n1", "width": 1, "pins": [{ "component": "clk", "pin": "out" }, { "component": "cnt", "pin": "clk" }] },
      { "id": "n2", "width": 1, "pins": [{ "component": "rst", "pin": "out" }, { "component": "cnt", "pin": "clr" }] },
      { "id": "n3", "width": 8, "pins": [{ "component": "cnt", "pin": "q" }, { "component": "split", "pin": "in" }] },
      { "id": "n4", "width": 1, "pins": [{ "component": "split", "pin": "out0" }, { "component": "s0", "pin": "in" }] },
      { "id": "n5", "width": 1, "pins": [{ "component": "split", "pin": "out1" }, { "component": "s1", "pin": "in" }] },
      { "id": "n6", "width": 1, "pins": [{ "component": "split", "pin": "out2" }, { "component": "s2", "pin": "in" }] },
      { "id": "n7", "width": 1, "pins": [{ "component": "split", "pin": "out3" }, { "component": "s3", "pin": "in" }] },
      { "id": "n8", "width": 1, "pins": [{ "component": "split", "pin": "out4" }, { "component": "s4", "pin": "in" }] },
      { "id": "n9", "width": 1, "pins": [{ "component": "split", "pin": "out5" }, { "component": "s5", "pin": "in" }] },
      { "id": "n10", "width": 1, "pins": [{ "component": "split", "pin": "out6" }, { "component": "s6", "pin": "in" }] },
      { "id": "n11", "width": 1, "pins": [{ "component": "split", "pin": "out7" }, { "component": "s7", "pin": "in" }] }
    ]
  }
}
