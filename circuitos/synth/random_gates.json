{
  "formatVersion": "1.0",
  "circuit": {
    "id": "random_gates",
    "components": [
      { "id": "clk", "type": "CLOCK", "label": "CLK", "params": { "period": 18, "width": 1, "initialValue": 0 }, "position": { "x": 40, "y": 140 }, "rotation": 0 },
      { "id": "lfsr", "type": "PSEUDO_RANDOM_GENERATOR", "label": "LFSR", "params": { "width": 8, "seed": 1 }, "position": { "x": 240, "y": 140 }, "rotation": 0 },
      { "id": "split", "type": "SPLITTER", "label": "BITS", "params": { "width": 8, "splits": [1, 1, 1, 1, 1, 1, 1, 1] }, "position": { "x": 460, "y": 140 }, "rotation": 0 },
      { "id": "g0", "type": "LED", "label": "RND0", "params": { "width": 1 }, "position": { "x": 680, "y": 0 }, "rotation": 0 },
      { "id": "g1", "type": "LED", "label": "RND1", "params": { "width": 1 }, "position": { "x": 680, "y": 70 }, "rotation": 0 },
      { "id": "g2", "type": "LED", "label": "RND2", "params": { "width": 1 }, "position": { "x": 680, "y": 140 }, "rotation": 0 },
      { "id": "g3", "type": "LED", "label": "RND3", "params": { "width": 1 }, "position": { "x": 680, "y": 210 }, "rotation": 0 },
      { "id": "hex", "type": "HEX_MONITOR", "label": "STATE", "params": { "width": 8, "format": "hex" }, "position": { "x": 460, "y": 320 }, "rotation": 0 }
    ],
    "nets": [
      { "id": "n1", "width": 1, "pins": [{ "component": "clk", "pin": "out" }, { "component": "lfsr", "pin": "clk" }] },
      { "id": "n2", "width": 8, "pins": [{ "component": "lfsr", "pin": "out" }, { "component": "split", "pin": "in" }, { "component": "hex", "pin": "in" }] },
      { "id": "n3", "width": 1, "pins": [{ "component": "split", "pin": "out0" }, { "component": "g0", "pin": "in" }] },
      { "id": "n4", "width": 1, "pins": [{ "component": "split", "pin": "out1" }, { "component": "g1", "pin": "in" }] },
      { "id": "n5", "width": 1, "pins": [{ "component": "split", "pin": "out2" }, { "component": "g2", "pin": "in" }] },
      { "id": "n6", "width": 1, "pins": [{ "component": "split", "pin": "out3" }, { "component": "g3", "pin": "in" }] }
    ]
  }
