      { "id": "n5", "width": 1, "pins": [{ "component": "dec", "pin": "out1" }, { "component": "led1", "pin": "in" }] },
      { "id": "n6", "width": 1, "pins": [{ "component": "dec", "pin": "out2" }, { "component": "led2", "pin": "in" }] },
      { "id": "n7", "width": 1, "pins": [{ "component": "dec", "pin": "out3" }, { "component": "led3", "pin": "in" }] }
