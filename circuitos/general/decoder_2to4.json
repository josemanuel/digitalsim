      { "id": "dec", "type": "DECODER", "label": "DEC 2→4", "params": { "selWidth": 2, "hasEnable": false }, "position": { "x": 380, "y": 120 }, "rotation": 0 },
      { "id": "led0", "type": "LED", "label": "Y0", "params": { "width": 1 }, "position": { "x": 600, "y": 20 }, "rotation": 0 },
      { "id": "led1", "type": "LED", "label": "Y1", "params": { "width": 1 }, "position": { "x": 600, "y": 100 }, "rotation": 0 },
      { "id": "led2", "type": "LED", "label": "Y2", "params": { "width": 1 }, "position": { "x": 600, "y": 180 }, "rotation": 0 },
