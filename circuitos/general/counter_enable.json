{
  "formatVersion": "1.0",
  "circuit": {
    "id": "counter_enable",
    "components": [
      { "id": "clk", "type": "CLOCK", "label": "CLOCK", "params": { "period": 20, "width": 1, "initialValue": 0 }, "position": { "x": 40, "y": 80 }, "rotation": 0 },
      { "id": "en", "type": "SWITCH", "label": "EN", "params": { "width": 1, "initialValue": 1 }, "position": { "x": 40, "y": 200 }, "rotation": 0 },
      { "id": "clr", "type": "PUSH_BUTTON", "label": "CLR", "params": { "activeHigh": true, "width": 1, "initialValue": 0 }, "position": { "x": 40, "y": 300 }, "rotation": 0 },
      { "id": "cnt", "type": "COUNTER", "label": "CNT", "params": { "bitWidth": 4, "mode": "up", "hasEnable": true, "hasClear": true, "hasLoad": false }, "position": { "x": 240, "y": 140 }, "rotation": 0 },
      { "id": "split", "type": "SPLITTER", "label": "SPLIT", "params": { "width": 4, "splits": [1, 1, 1, 1] }, "position": { "x": 440, "y": 140 }, "rotation": 0 },
      { "id": "led0", "type": "LED", "label": "Q0", "params": { "width": 1 }, "position": { "x": 640, "y": 20 }, "rotation": 0 },
      { "id": "led1", "type": "LED", "label": "Q1", "params": { "width": 1 }, "position": { "x": 640, "y": 110 }, "rotation": 0 },
      { "id": "led2", "type": "LED", "label": "Q2", "params": { "width": 1 }, "position": { "x": 640, "y": 200 }, "rotation": 0 },
      { "id": "led3", "type": "LED", "label": "Q3", "params": { "width": 1 }, "position": { "x": 640, "y": 290 }, "rotation": 0 },
      { "id": "hex", "type": "HEX_MONITOR", "label": "HEX", "params": { "width": 4, "format": "hex" }, "position": { "x": 440, "y": 300 }, "rotation": 0 }
    ],
    "nets": [
      { "id": "n1", "width": 1, "pins": [{ "component": "clk", "pin": "out" }, { "component": "cnt", "pin": "clk" }] },
      { "id": "n2", "width": 1, "pins": [{ "component": "en", "pin": "out" }, { "component": "cnt", "pin": "en" }] },
      { "id": "n3", "width": 1, "pins": [{ "component": "clr", "pin": "out" }, { "component": "cnt", "pin": "clr" }] },
      { "id": "n4", "width": 4, "pins": [{ "component": "cnt", "pin": "q" }, { "component": "split", "pin": "in" }, { "component": "hex", "pin": "in" }] },
      { "id": "n5", "width": 1, "pins": [{ "component": "split", "pin": "out0" }, { "component": "led0", "pin": "in" }] },
      { "id": "n6", "width": 1, "pins": [{ "component": "split", "pin": "out1" }, { "component": "led1", "pin": "in" }] },
      { "id": "n7", "width": 1, "pins": [{ "component": "split", "pin": "out2" }, { "component": "led2", "pin": "in" }] },
      { "id": "n8", "width": 1, "pins": [{ "component": "split", "pin": "out3" }, { "component": "led3", "pin": "in" }] }
    ]
  }
}
